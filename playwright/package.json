{
  "name": "sinergiacrm-playwright",
  "private": true,
  "type": "module",
  "imports": {
    "#pages/*":       "./pages/*.ts",
    "#helpers/*":     "./helpers/*.ts",
    "#specs/*":       "./specs/*.ts",
    "#models/*":      "./models/*.ts",
    "#settings":      "./settings.ts",
    "#global-setup":  "./global-setup.ts"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.6.0"
  }
}
